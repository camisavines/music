# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js build output ──────────────────────────────────────────────────────
.next/
out/

# ── Production build (if exported) ───────────────────────────────────────────
build/
dist/

# ── Environment variables — NEVER commit real secrets ────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is intentionally NOT ignored (safe template for collaborators)

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS / editor artefacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# VS Code — keep shared settings, ignore personal/machine state
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# JetBrains IDEs
.idea/
*.iml

# Vim / Emacs swap files
*.sw?
*.sln
*.suo
*.ntvs*
*.njsproj

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.local
